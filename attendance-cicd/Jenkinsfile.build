pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {

        AWS_REGION = 'ap-south-1'

        AWS_ACCOUNT_ID = credentials('aws-account-id')

        ECR_REPO = 'attendance-management'

        IMAGE_TAG = "${BUILD_NUMBER}"

        ECR_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}"

        BUILD_USER = 'jainritika4605@gmail.com'
    }

    triggers {
        githubPush()
    }

    stages {

        stage('Checkout') {

            steps {
                checkout scm
            }
        }

        stage('Run Tests') {

            steps {

                bat """
                mvnw.cmd test
                """
            }
        }

        stage('Build JAR') {

            steps {

                bat """
                mvnw.cmd clean package -DskipTests
                """
            }
        }

        stage('Build Docker Image') {

            steps {

                bat """
                docker build -t attendance-management:%IMAGE_TAG% .
                """
            }
        }

        stage('Login to ECR') {

            steps {

                withAWS(credentials: 'aws_creds', region: 'ap-south-1') {

                    bat """
                    aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin %AWS_ACCOUNT_ID%.dkr.ecr.ap-south-1.amazonaws.com
                    """
                }
            }
        }

        stage('Tag Docker Image') {

            steps {

                bat """
                docker tag attendance-management:%IMAGE_TAG% %ECR_URI%:%IMAGE_TAG%

                docker tag attendance-management:%IMAGE_TAG% %ECR_URI%:latest
                """
            }
        }

        stage('Push Docker Image') {

            steps {

                bat """
                docker push %ECR_URI%:%IMAGE_TAG%

                docker push %ECR_URI%:latest
                """
            }
        }
    }

    post {

        success {

            emailext(
                subject: "SUCCESS: Attendance Build #%BUILD_NUMBER%",
                body: """
Build completed successfully.

Docker Image:
%ECR_URI%:%IMAGE_TAG%

""",
                to: "${BUILD_USER}"
            )
        }

        failure {

            emailext(
                subject: "FAILED: Attendance Build #%BUILD_NUMBER%",
                body: """
Build failed.

Check Jenkins logs:
%BUILD_URL%

""",
                to: "${BUILD_USER}"
            )
        }

        always {

            bat """
            docker image prune -f
            """
        }
    }
}