pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {

        AWS_REGION = 'ap-south-1'

        AWS_ACCOUNT_ID = credentials('aws-account-id')

        ECR_REPO = 'attendance-management'

        IMAGE_TAG = "${BUILD_NUMBER}"

        ECR_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}"
    }

    triggers {
        githubPush()
    }

    stages {

        stage('Checkout') {

            steps {

                git branch: 'main',
                    url: 'https://github.com/ritikaj22/attendance-management-system.git'
            }
        }

        stage('Build JAR') {

            steps {

                sh '''
                cd attendance-cicd

                mvn clean package -DskipTests
                '''
            }
        }

        stage('Build Docker Image') {

            steps {

                sh '''
                cd attendance-cicd

                docker build -t attendance-management:${IMAGE_TAG} .
                '''
            }
        }

        stage('Login to ECR') {

            steps {

                withAWS(credentials: 'aws_creds', region: 'ap-south-1') {

                    sh '''
                    aws ecr get-login-password --region ap-south-1 | \
                    docker login --username AWS --password-stdin \
                    ${AWS_ACCOUNT_ID}.dkr.ecr.ap-south-1.amazonaws.com
                    '''
                }
            }
        }

        stage('Tag Docker Image') {

            steps {

                sh '''
                docker tag attendance-management:${IMAGE_TAG} ${ECR_URI}:${IMAGE_TAG}

                docker tag attendance-management:${IMAGE_TAG} ${ECR_URI}:latest
                '''
            }
        }

        stage('Push Docker Image') {

            steps {

                sh '''
                docker push ${ECR_URI}:${IMAGE_TAG}

                docker push ${ECR_URI}:latest
                '''
            }
        }
    }

    post {

        success {

            emailext(
                subject: "SUCCESS: Attendance Build #${BUILD_NUMBER}",
                body: """
Build completed successfully.

Project:
Attendance Management System

Docker Image:
${ECR_URI}:${IMAGE_TAG}

Build URL:
${BUILD_URL}
""",
                to: "jainritika4605@gmail.com"
            )
        }

        failure {

            emailext(
                subject: "FAILED: Attendance Build #${BUILD_NUMBER}",
                body: """
Build failed.

Check Jenkins logs:
${BUILD_URL}
""",
                to: "jainritika4605@gmail.com"
            )
        }

        always {

            sh '''
            docker image prune -f || true
            '''
        }
    }
}