pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['staging', 'production'],
            description: 'Deployment environment'
        )

        string(
            name: 'BUILD_NUMBER',
            defaultValue: 'latest',
            description: 'Docker image tag'
        )
    }

    environment {

        AWS_REGION = 'ap-south-1'

        AWS_ACCOUNT_ID = '094005227117'

        ECR_REPO = 'attendance-management'

        ECR_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}"

        IMAGE_TAG = "${params.BUILD_NUMBER}"

        DOCKER_IMAGE = "${ECR_URI}:${IMAGE_TAG}"

        SERVER_IP = '13.233.216.182'

        SSH_USER = 'ec2-user'

        CONTAINER_NAME = 'attendance-app'

        BUILD_USER = 'jainritika4605@gmail.com'
    }

    stages {

        stage('Verify ECR Image') {

            steps {

                withAWS(credentials: 'aws_creds', region: 'ap-south-1') {

                    bat """
                    aws ecr describe-images ^
                    --repository-name attendance-management ^
                    --image-ids imageTag=${IMAGE_TAG}
                    """
                }
            }
        }

        stage('Deploy to EC2') {

            steps {

                sshagent(credentials: ['aws_ec2_key_devops']) {

                    bat """
                    ssh -o StrictHostKeyChecking=no ${SSH_USER}@${SERVER_IP} ^

                    "aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin ${AWS_ACCOUNT_ID}.dkr.ecr.ap-south-1.amazonaws.com && docker pull ${DOCKER_IMAGE} && docker stop ${CONTAINER_NAME} || true && docker rm ${CONTAINER_NAME} || true && docker image prune -f || true && docker run -d --name ${CONTAINER_NAME} -p 80:8080 ${DOCKER_IMAGE}"
                    """
                }
            }
        }

        stage('Wait For Startup') {

            steps {
                sleep(time: 15, unit: 'SECONDS')
            }
        }

        stage('Health Check') {

            steps {

                retry(3) {

                    bat """
                    curl --fail http://${SERVER_IP}/attendance/health
                    """
                }
            }
        }

        stage('Smoke Test') {

            steps {

                bat """
                curl -X POST ^
                -H "Content-Type: application/json" ^
                -d "{\\"userId\\":\\"TEST001\\",\\"userName\\":\\"Smoke Test\\",\\"location\\":\\"Jenkins\\"}" ^
                http://${SERVER_IP}/attendance/checkin
                """
            }
        }
    }

    post {

        success {

            emailext(
                subject: "SUCCESS: Deployment #${BUILD_NUMBER}",
                body: """
Deployment completed successfully.

Environment:
${params.ENVIRONMENT}

Docker Image:
${DOCKER_IMAGE}

Server:
${SERVER_IP}

""",
                to: "${BUILD_USER}"
            )
        }

        failure {

            emailext(
                subject: "FAILED: Deployment #${BUILD_NUMBER}",
                body: """
Deployment failed.

Check Jenkins logs:
${BUILD_URL}

""",
                to: "${BUILD_USER}"
            )
        }
    }
}