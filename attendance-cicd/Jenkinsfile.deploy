pipeline {

    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['staging', 'production'],
            description: 'Deployment environment'
        )

        string(
            name: 'BUILD_NUMBER',
            defaultValue: 'latest',
            description: 'Docker image tag'
        )
    }

    environment {

        AWS_REGION = 'ap-south-1'

        AWS_ACCOUNT_ID = credentials('aws-account-id')

        ECR_REPO = 'attendance-management'

        ECR_URI = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${ECR_REPO}"

        IMAGE_TAG = "${params.BUILD_NUMBER}"

        DOCKER_IMAGE = "${ECR_URI}:${IMAGE_TAG}"

        SERVER_IP = credentials('ec2-server-ip')

        SSH_USER = 'ec2-user'

        CONTAINER_NAME = 'attendance-app'
    }

    stages {

        stage('Verify ECR Image') {

            steps {

                withAWS(credentials: 'aws_creds', region: 'ap-south-1') {

                    sh '''
                    aws ecr describe-images \
                    --repository-name attendance-management \
                    --image-ids imageTag=${IMAGE_TAG}
                    '''
                }
            }
        }

        stage('Deploy to EC2') {

            steps {

                sshagent(credentials: ['aws_ec2_key_devops']) {

                    sh '''
                    ssh -o StrictHostKeyChecking=no ${SSH_USER}@${SERVER_IP} "

                    aws ecr get-login-password --region ap-south-1 | \
                    docker login --username AWS --password-stdin \
                    ${AWS_ACCOUNT_ID}.dkr.ecr.ap-south-1.amazonaws.com

                    docker pull ${DOCKER_IMAGE}

                    docker stop ${CONTAINER_NAME} || true
                    docker rm ${CONTAINER_NAME} || true

                    docker image prune -f || true

                    docker run -d \
                      --name ${CONTAINER_NAME} \
                      -p 80:8080 \
                      ${DOCKER_IMAGE}
                    "
                    '''
                }
            }
        }

        stage('Wait For Startup') {

            steps {
                sleep(time: 15, unit: 'SECONDS')
            }
        }

        stage('Health Check') {

            steps {

                retry(3) {

                    sh '''
                    curl --fail http://${SERVER_IP}/attendance/health
                    '''
                }
            }
        }
    }

    post {

        success {

            echo 'Deployment successful'
        }

        failure {

            echo 'Deployment failed'
        }
    }
}